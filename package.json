  "repository": {
    "type": "git",
    "url": "git+https://github.com/Patruxs/dexport.git"
  },
  "license": "MIT",
  "author": "Patruxs",
  "type": "commonjs",
  "bin": {
    "dexport": "npm/cli.js"
  },
  "scripts": {
